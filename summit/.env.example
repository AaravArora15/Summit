# Copy to .env and fill in from your Supabase project settings (API section).
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time and are therefore
# public. That is correct for these two: the anon key identifies the project, it
# does not grant access. Row Level Security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# RevenueCat "public" SDK keys — one per store, from the RevenueCat dashboard
# (Project settings -> API keys). These are safe to ship in the bundle the same
# way the Supabase anon key is: they identify the app to RevenueCat, they don't
# grant purchasing power on their own. Leave blank to run with the paywall
# disabled — see src/lib/purchases.ts.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional. Summit's map cartography (src/features/map/style.ts) is built in
# and needs nothing set here — this only overrides it with a hosted style
# JSON URL instead, e.g. a real vector-tile provider's own style. Leave blank.
EXPO_PUBLIC_MAP_STYLE_URL=
