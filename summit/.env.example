# Copy to .env and fill in from your Supabase project settings (API section).
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time and are therefore
# public. That is correct for these two: the anon key identifies the project, it
# does not grant access. Row Level Security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
